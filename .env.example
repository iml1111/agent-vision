# =============================================================================
# Agent Vision - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# Application
ENV=development

# =============================================================================
# MongoDB (Required)
# =============================================================================
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=agent_vision

# =============================================================================
# AWS (Required)
# =============================================================================
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2

# AWS SQS FIFO Queue URL
SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/your-account/agent_vision_queue.fifo

# =============================================================================
# AI APIs (Required)
# =============================================================================
# Anthropic - Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI - Embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-xxx

# =============================================================================
# External Integrations (Required)
# =============================================================================
# Slack Bot Token (for SlackAgent)
SLACK_BOT_TOKEN=xoxb-xxx

# Notion API Key (for ProductDomainAgent)
NOTION_API_KEY=secret_xxx

# Notion EventLog Spec Database ID
NOTION_EVENTLOG_SPEC_DB_ID=your-eventlog-spec-db-id
