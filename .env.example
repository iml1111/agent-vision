# Application
ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=agent_vision

# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2

# AWS SQS (FIFO Queue)
# Note: FIFO queue must have ContentBasedDeduplication=false
SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/your-account/agent-vision.fifo

# Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI (Embeddings)
OPENAI_API_KEY=sk-xxx

# External Integrations
SLACK_BOT_TOKEN=xoxb-xxx
NOTION_API_KEY=secret_xxx

# Notion EventLog Spec DB
NOTION_EVENTLOG_SPEC_DB_ID=your-eventlog-spec-db-id
